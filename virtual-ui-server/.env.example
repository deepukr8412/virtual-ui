# Port for the Node.js server
PORT=8000

# MongoDB Connection String (e.g., MongoDB Atlas or local MongoDB)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/your_db

# Secret key for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_string

# OpenRouter API Key for AI generation
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Razorpay Test Credentials for Payments
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
